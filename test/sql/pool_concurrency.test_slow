# name: test/sql/pool_concurrency.test_slow
# description: connection pooling (slow) — pooled growth/reuse under load, error recovery, reclamation
# group: [sql]

# ------------------------------------------------------------------------------
# WHAT THIS COVERS, AND THE ONE HONEST LIMIT:
#
# sqllogic drives statements sequentially per connection tag, so it cannot hold N
# pooled checkouts SIMULTANEOUSLY — i.e. it cannot drive the pool to live=N or
# exercise exhaustion backpressure / checkout timeout, which need N concurrent
# in-flight transactions. Those are covered by the out-of-process integration
# harness (test/integration/pool_two_process.sh) and design review.
#
# Everything else is asserted for real here. In particular the pool DOES grow to a
# second (non-primary) connection from inside an explicit transaction, and that
# pooled connection is reused / released / re-checked-out across many sequential
# transactions. (An earlier version of this test claimed that mint deadlocks the
# in-process server and therefore could not be asserted. That was a misdiagnosis:
# the deadlock was a client-side ClientContext re-entry during the mint, fixed by
# minting context-free; growth is asserted directly below.)
#
# Note on timing: DuckDB starts an attached catalog's transaction LAZILY, on the
# first access to that catalog inside the transaction. So the pooled checkout fires
# at the first `from <quack_catalog>...` within the txn, not at `begin`.
# ------------------------------------------------------------------------------

require quack

require httpfs

set ignore_error_messages __none__

statement ok
create table fuu as values(42, 43);

foreach server 'quack:localhost'

statement ok con1
call quack_serve({server}, token='asdf');

# (1) pool_size=1 stays single-lane under repeated transactional reads: the
# pool_size==1 fast path mints nothing, so the per-transaction affinity resolves to
# (and releases) the primary and the server never sees more than one connection.
statement ok con2
attach {server} as one (token 'asdf', pool_size 1)

query I con1
select count(*) from quack_active_connections();
----
1

loop i 0 10

statement ok con2
begin transaction

query II con2
from one.fuu;
----
42	43

statement ok con2
commit

endloop

query I con1
select count(*) from quack_active_connections();
----
1

query III con1
select live, in_use, idle from quack_pool_status() where catalog='one';
----
1	0	0

statement ok con2
detach one;

# (2) pool_size>1: explicit transactions check out a POOLED (non-primary) connection
# and reuse it across many sequential transactions. live grows to exactly 2 (primary
# + one pooled connection) and stays there — the warm pooled connection is reused, not
# re-minted each time — and the server sees exactly 2 connections.
statement ok con2
attach {server} as many (token 'asdf', pool_size 4)

query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
1	0	0

loop i 0 25

statement ok con2
begin transaction

query II con2
from many.fuu;
----
42	43

# while con2's transaction is open, con1 sees the pooled connection checked out.
query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
2	1	0

statement ok con2
commit

endloop

# at rest after the load: pooled connection returned to idle, nothing leaked.
query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
2	0	1

# exactly two server-side connections exist for this catalog (primary + 1 pooled).
query I con1
select count(*) from quack_active_connections();
----
2

# (3) Error mid-transaction does not leak or strand a pooled connection. The bad
# table reference aborts the statement; after ROLLBACK the pooled connection is
# returned cleanly to idle (in_use back to 0) and a fresh transaction reuses it.
#
# NOTE: true hard-cancellation (interrupting a query mid-flight, so the connection is
# reset as dirty and discarded) is not expressible from sqllogic; this asserts the
# error-then-rollback reclamation proxy. The dirty-discard path is covered by design
# (quack_transaction.cpp marks the connection dirty on a thrown metadata query and
# ReleaseConnection discards it instead of returning it to idle) and by the
# out-of-process harness.
statement ok con2
begin transaction

query II con2
from many.fuu;
----
42	43

statement error con2
from many.does_not_exist;
----
does not exist

statement ok con2
rollback

query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
2	0	1

# the pool still works after the error: a new transaction reuses the idle connection.
statement ok con2
begin transaction

query II con2
from many.fuu;
----
42	43

query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
2	1	0

statement ok con2
commit

# (4) Reclamation / clean at-rest, and detach tears the pooled connection down.
query III con1
select live, in_use, idle from quack_pool_status() where catalog='many';
----
2	0	1

statement ok con2
detach many;

query I con1
select count(*) from quack_active_connections();
----
0

statement ok con1
call quack_stop({server});

endloop
