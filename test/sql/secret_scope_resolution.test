# name: test/sql/secret_scope_resolution.test
# description: how a quack secret is matched to an endpoint, and when a server may adopt its token
# group: [sql]

require quack

require httpfs

# --- 1. A scope written in the `quack://` spelling still resolves ---

# Secret scopes are matched as plain string prefixes. The lookup prefers the canonical
# `quack:<host>:<port>` form so a secret matches however the endpoint was spelled, but
# canonicalising drops the `//` - so a scope written as `quack://host:port` is not a
# prefix of it. The raw spelling is tried as a fallback to keep such scopes working.

statement ok con1
call quack_serve('quack://localhost:20211', token='scheme_tok');

statement ok con2
create secret quack_scheme (type quack, token 'scheme_tok', scope 'quack://localhost:20211')

statement ok con2
attach 'quack://localhost:20211' as r_scheme (type quack)

query II con2
from r_scheme.query('select 1, 2')
----
1	2

statement ok con2
detach r_scheme

statement ok con2
drop secret quack_scheme

statement ok con1
call quack_stop('quack://localhost:20211')

# --- 2. One secret supplies both the token and the extra headers ---

# The token and the EXTRA_HTTP_HEADERS used to be looked up under different keys, so a
# secret could authenticate the connection while silently contributing no headers. Both
# now go through the same resolution, including the `quack://` fallback above.

statement ok con1
call quack_serve('quack://localhost:20212', token='both_tok');

statement ok con2
create secret quack_both (
    type quack,
    token 'both_tok',
    extra_http_headers MAP {'X-Trace': 'abc123'},
    scope 'quack://localhost:20212'
)

statement ok con2
attach 'quack://localhost:20212' as r_both (type quack)

query II con2
from r_both.query('select 3, 4')
----
3	4

statement ok con2
detach r_both

statement ok con2
drop secret quack_both

statement ok con1
call quack_stop('quack://localhost:20212')

# --- 3. quack_serve does not adopt a catch-all secret's token ---

# An unscoped secret defaults to the scope `quack:`, which prefix-matches every endpoint.
# Such a secret was written to reach some other server; adopting it as this listener's
# token would let everyone holding that token in to the new server. A random token must
# be generated instead.

statement ok
create secret quack_catchall (type quack, token 'catch_all_token')

query I
SELECT auth_token != 'catch_all_token'
       AND length(auth_token) = 32
       AND regexp_matches(auth_token, '^[0-9A-F]+$')
FROM quack_serve('quack:localhost:20213');
----
true

statement ok
CALL quack_stop('quack:localhost:20213');

statement ok
drop secret quack_catchall

# --- 4. ...but a secret scoped to the endpoint is still adopted ---

# The catch-all check must not swallow the feature it guards: an explicitly scoped secret
# is evidence the user meant this endpoint, so its token is used.

statement ok
create secret quack_scoped (type quack, token 'scoped_token', scope 'quack:localhost:20214')

query III
FROM quack_serve('quack:localhost:20214');
----
quack:localhost:20214	http://localhost:20214	scoped_token

statement ok
CALL quack_stop('quack:localhost:20214');

statement ok
drop secret quack_scoped

# --- 5. A secret with both a catch-all and an endpoint scope is adopted ---

# Only a secret whose scopes are *all* the catch-all is refused; one that also names the
# endpoint carries the intent we are looking for.

statement ok
create secret quack_mixed (type quack, token 'mixed_token', scope ['quack:', 'quack:localhost:20215'])

query III
FROM quack_serve('quack:localhost:20215');
----
quack:localhost:20215	http://localhost:20215	mixed_token

statement ok
CALL quack_stop('quack:localhost:20215');

statement ok
drop secret quack_mixed
